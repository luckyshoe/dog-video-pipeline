{
  "name": "dog-video-pipeline",
  "version": "1.0.0",
  "description": "Automated dog video pipeline: scrape, analyze, generate, approve, publish",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "scrape": "node -e \"require('./src/layers/scrape').scrapeAndQueue()\"",
    "analyze": "node -e \"require('./src/layers/analyze').analyzeNextVideo()\"",
    "generate": "node -e \"require('./src/layers/generate').generateVideo()\"",
    "review": "node -e \"require('./src/layers/self-improve').selfImprovementReview()\""
  },
  "dependencies": {
    "@fal-ai/client": "^1.9.5",
    "@supabase/supabase-js": "^2.49.0",
    "apify-client": "^2.11.0",
    "node-cron": "^3.0.3",
    "telegraf": "^4.16.0",
    "googleapis": "^144.0.0",
    "fluent-ffmpeg": "^2.1.3",
    "dotenv": "^16.4.7"
  }
}
